{
  "name": "credit-card-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "format": "prettier --write src/ e2e/ playwright.config.ts",
    "format:check": "prettier --check src/ e2e/ playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "generate:api": "orval"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/d3-hierarchy": "^3.1.7",
    "axios": "^1.7.7",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "orval": "^8.24.0",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
