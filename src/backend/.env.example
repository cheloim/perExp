# ─── Required ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-at-least-32-characters-long

# ─── Key Separation (optional but recommended) ──────────────────────
# Separate JWT signing key. Falls back to SECRET_KEY if not set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=

# Separate encryption key for PII fields (Fernet). Falls back to SECRET_KEY if not set.
# ⚠️  Changing this requires re-encrypting ALL data — see scripts/migrate_separate_keys.py
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# PostgreSQL
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql://expenses_user:your-postgres-password@localhost:5432/expenses

# ─── Auth / OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
JWT_EXPIRE_DAYS=7

# ─── Seed user (created on first boot) ──────────────────────────────
SEED_USER_EMAIL=admin@example.com
SEED_USER_NAME=Admin
SEED_USER_PASSWORD=ChangeMe123!

# ─── Telegram Bot ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=NikoFin_bot
TELEGRAM_BOT_ENABLED=true

# ─── Telegram OIDC (BotFather → Bot Settings → Web Login) ──────────
# TELEGRAM_OIDC_CLIENT_ID=your-client-id
# TELEGRAM_OIDC_CLIENT_SECRET=your-client-secret

# ─── WhatsApp Bot ────────────────────────────────────────────────────
# WHATSAPP_VERIFY_TOKEN=oikonomia-whatsapp-dev
# WHATSAPP_APP_SECRET=your-meta-app-secret

# ─── LLM / AI ───────────────────────────────────────────────────────
# Key names are provider-agnostic: the code reads LLM_API_KEY regardless of
# which model is behind it, so swapping providers is a configuration change,
# not a code change.
LLM_API_KEY=your-llm-api-key

# Provider: "openai" | "google". Leave unset to infer it from the key shape
# (sk-... is OpenAI, anything else is Google) — so replacing the value of
# LLM_API_KEY is enough to move providers.
# LLM_PROVIDER=openai

# Model per provider. Defaults: gpt-6-luna (openai) / gemini-flash-latest (google).
# LLM_MODEL_NAME=gpt-6-luna

# Per-call timeout in seconds (default 30).
# LLM_TIMEOUT_SECONDS=30

# ── LLM budget / credit, for the Grafana dashboard ──────────────────
# Hard monthly ceiling used for the budget gauge and its alerts (USD).
# LLM_MONTHLY_BUDGET_USD=10
# Prepaid credit purchased, and when it expires (OpenAI credits last 12 months).
# LLM_CREDIT_AMOUNT_USD=10
# LLM_CREDIT_EXPIRES_AT=2027-10-20

# Optional: separate billing for the investments assistant. Falls back to
# LLM_API_KEY when unset.
# INVESTMENTS_LLM_API_KEY=your-llm-api-key

# Optional: separate key for the Telegram / WhatsApp bot. Falls back to
# LLM_API_KEY when unset.
# MESSAGES_BOT_LLM_API_KEY=your-llm-api-key

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Isolated cache DB (never the Celery broker DB — a FLUSHDB or broker
# pressure must not evict API cache). Compose sets redis://redis:6379/2.
REDIS_CACHE_URL=redis://localhost:6379/2
# Kill-switch for low-hit keys: comma-separated key prefixes, no restart of
# code needed (env change + process restart). Revert rule: any prefix with
# 7-day hit rate <30% goes on this list.
# e.g. CACHE_DISABLED_PREFIXES=v1:uncat,v1:prices
# CACHE_DISABLED_PREFIXES=

# ─── Email notifications (Resend) ────────────────────────────────────
EMAIL_API_KEY=re_xxxxx
ADMIN_EMAIL=admin@yourdomain.com

# ─── CORS (comma-separated origins) ─────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8082

# ─── Environment ────────────────────────────────────────────────────
APP_ENV=development# OIDC SSO deployed via #289
# OIDC deployed
