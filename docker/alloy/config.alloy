// Alloy: read logs from journalctl export and push to Loki.
// All monitoring services share the compose network, so Loki is
// reachable as http://loki:3100 via compose DNS (no hardcoded IPs,
// no host-network coupling).
// Rootless podman can't read /run/log/journal directly,
// so we read from a journalctl export file instead.

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

loki.source.file "journal_export" {
  targets = [
    { __path__ = "/logs/journal.log", job = "systemd-journal" },
  ]
  forward_to = [loki.process.parse.receiver]
}

loki.process "parse" {
  forward_to = [loki.write.local.receiver]

  // 0. Drop torn lines (rotation/truncation can split a JSON record;
  //    a fragment never parses and would otherwise glue raw JSON
  //    onto the previous entry via the multiline stage below).
  //    A valid journal line always starts with "{" and ends with "}".
  stage.drop {
    source     = ""
    expression = "^[^{]"
  }

  stage.drop {
    source     = ""
    expression = "[^}]$"
  }

  // 1. Parse journal JSON to extract fields
  stage.json {
    expressions = {
      msg       = "MESSAGE",
      container = "CONTAINER_NAME",
      priority  = "PRIORITY",
    }
  }

  // 2. Replace raw JSON log body with just the MESSAGE field
  stage.output {
    source = "msg"
  }

  // 3. Reassemble multi-line logs (e.g. Python tracebacks) into ONE entry.
  //    journald splits every newline into its own entry, which scatters a
  //    33-line traceback across 33 Loki entries (shown reversed in Grafana).
  //    Any line matching firstline starts a new entry; anything else is
  //    appended to the in-progress one. Calibrated 2026-10-13 against the
  //    real formats in journal.log:
  //      DATE  "2026-10-13 01:32:14..." (app logs, health checks)
  //      LEVEL "INFO: ..."/"ERROR: ..." (uvicorn)
  //      NGINX "10.89.0.200 - - [...]" (nginx + frontend access logs)
  //      LOGFMT "level=info ts=..." (loki) / "logger=..." (grafana)
  //      OTHER "time=... level=WARN ..." (blackbox) / "ts=... level=..." (loki)
  //    Traceback bodies ("  File ...", "| ...", "^^^", source lines) never
  //    match firstline, so they glue to their header line. Labels of the
  //    first line win, so container/level stay correct for the whole trace.
  stage.multiline {
    firstline = "^(?:\\d{4}-\\d{2}-\\d{2}|INFO:|ERROR:|WARNING:|level=|logger=|time=|ts=|\\d{1,3}(?:\\.\\d{1,3}){3} -)"
    max_wait_time = "3s"
    max_lines     = 200
  }

  // 3. Extract real level from message content.
  //    Many containers write INFO/WARNING/LOG to stderr (PRIORITY=3).
  //    We detect the real level from the message to override PRIORITY.
  stage.regex {
    expression = "(?i)(?P<msg_level>INFO|WARNING|WARN|ERROR|DEBUG|CRITICAL|LOG)"
  }

  // 4. Smart level mapping:
  //    - Monitoring containers (loki, alloy, exporters) always get info
  //    - If message says INFO/LOG/DEBUG but PRIORITY=3 (stderr) → info
  //    - If message says WARNING/WARN but PRIORITY=3 → warning
  //    - Otherwise use PRIORITY: 3=error, 4=warning, 6=info, 7=debug
  stage.template {
    source   = "level"
    template = "{{ if or (contains \"loki\" .container) (contains \"alloy\" .container) (contains \"exporter\" .container) }}info{{ else if and (eq .priority \"3\") (or (eq .msg_level \"INFO\") (eq .msg_level \"LOG\") (eq .msg_level \"DEBUG\")) }}info{{ else if and (eq .priority \"3\") (or (eq .msg_level \"WARNING\") (eq .msg_level \"WARN\") (eq .msg_level \"CRITICAL\")) }}warning{{ else if eq .priority \"3\" }}error{{ else if eq .priority \"4\" }}warning{{ else if eq .priority \"6\" }}info{{ else if eq .priority \"7\" }}debug{{ else }}unknown{{ end }}"
  }

  // 5. Set labels for querying in Grafana
  stage.labels {
    values = {
      level     = "level",
      container = "container",
    }
  }
}