// Alloy: read logs from journalctl export and push to local Loki
// Alloy runs on host network, so Loki is at localhost:3100
// Rootless podman can't read /run/log/journal directly,
// so we read from a journalctl export file instead.

loki.write "local" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}

loki.source.file "journal_export" {
  targets = [
    { __path__ = "/logs/journal.log", job = "systemd-journal" },
  ]
  forward_to = [loki.process.parse.receiver]
}

loki.process "parse" {
  forward_to = [loki.write.local.receiver]

  // 1. Parse journal JSON to extract fields
  stage.json {
    expressions = {
      msg       = "MESSAGE",
      container = "CONTAINER_NAME",
      priority  = "PRIORITY",
    }
  }

  // 2. Replace log body with just the MESSAGE field
  stage.output {
    source = "msg"
  }

  // 3. Map journal priority to level, downgrading monitoring containers.
  //    Loki and Alloy write to stderr which journald marks as PRIORITY=3 (error),
  //    but their actual log level is usually info/warn. Downgrade monitoring
  //    container "errors" to info to reduce noise in the dashboard.
  stage.template {
    source   = "level"
    template = "{{ if and (eq .priority \"3\") (or (contains \"loki\" .container) (contains \"alloy\" .container) (contains \"exporter\" .container)) }}info{{ else if eq .priority \"3\" }}error{{ else if eq .priority \"4\" }}warning{{ else if eq .priority \"6\" }}info{{ else if eq .priority \"7\" }}debug{{ else }}unknown{{ end }}"
  }

  // 4. Set labels for querying in Grafana
  stage.labels {
    values = {
      container = "container",
      level     = "level",
    }
  }
}