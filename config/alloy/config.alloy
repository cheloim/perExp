// ── Grafana Cloud credentials (env vars from .env) ────────

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_PROMETHEUS_PASSWORD")
    }
  }
}

// ── Scrape all exporters (localhost — all on host network) ──

prometheus.scrape "backend" {
  targets         = [{"__address__" = "localhost:8000", "job" = "oikonomia-backend"}]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "postgres" {
  targets         = [{"__address__" = "localhost:9187", "job" = "postgres"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "redis" {
  targets         = [{"__address__" = "localhost:9121", "job" = "redis"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "node" {
  targets         = [{"__address__" = "localhost:9100", "job" = "node"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "nginx" {
  targets         = [{"__address__" = "localhost:9113", "job" = "nginx"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "cadvisor" {
  targets         = [{"__address__" = "localhost:8080", "job" = "cadvisor"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "alloy" {
  targets         = [{"__address__" = "localhost:12345", "job" = "alloy"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "blackbox" {
  targets         = [
    {"__address__" = "localhost:9115", "__param_target" = "https://oikonomia.ar", "instance" = "https://oikonomia.ar", "job" = "blackbox"},
    {"__address__" = "localhost:9115", "__param_target" = "https://platform.oikonomia.ar", "instance" = "https://platform.oikonomia.ar", "job" = "blackbox"},
  ]
  metrics_path    = "/probe"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Loki: write logs to Grafana Cloud ─────────────────────

loki.write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = env("GRAFANA_CLOUD_LOKI_USER")
      password = env("GRAFANA_CLOUD_LOKI_PASSWORD")
    }
  }
}

// ── Journal logs → Grafana Cloud Loki ─────────────────────

loki.source.journal "containers" {
  max_age       = "12h"
  relabel_rules = discovery.relabel.journal_rules.rules
  forward_to    = [loki.write.grafana_cloud.receiver]
}

discovery.relabel "journal_rules" {
  targets = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__cmdline"]
    regex         = ".*\\s-n\\s+(\\S+).*"
    target_label  = "container"
  }

  rule {
    source_labels = ["__journal__priority_keyword"]
    target_label  = "level"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    target_label = "job"
    replacement  = "systemd-journal"
  }
}
