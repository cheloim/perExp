# Oikonomia — variables de entorno
#
# Este archivo documenta la superficie de configuración. Copialo a `.env`:
#     cp .env.example .env
#
# `.env` sólo se usa para INTERPOLAR valores en podman-compose.yml.
# Los secretos reales (SECRET_KEY, tokens, API keys) NO van acá: se cargan con
#     ./scripts/setup-secrets.sh dev   # o `prod`, o sin argumento = prod
# que los publica como Podman secrets desde secrets/<env>/backend/*.
#
# Ver docs/Configuration.md para la explicación de cada variable.

# ---------------------------------------------------------------------------
# Obligatorias en local (interpoladas por podman-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=                # password del Postgres de producción
POSTGRES_PASSWORD_DEV=            # password del Postgres de desarrollo

# ---------------------------------------------------------------------------
# Opcionales en local: defaults del compose
# ---------------------------------------------------------------------------
APP_ENV=development               # development | production
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:8001

LLM_PROVIDER=openai               # openai | google
LLM_MODEL_NAME=gpt-6-luna
LLM_AUDIO_MODEL=gpt-4o-mini-transcribe
LLM_VISION_MODEL=                 # vacío = usa LLM_MODEL_NAME
LLM_MONTHLY_BUDGET_USD=10
LLM_CREDIT_AMOUNT_USD=10
LLM_CREDIT_EXPIRES_AT=
LLM_TIMEOUT_SECONDS=30

SMTP_FROM=NikoFin
SMTP_FROM_ADDRESS=noreply@resend.dev
ADMIN_EMAIL=admin@nikofin.com

BUDGET_AHORRO_ENABLED=true
DEBUG_CATEGORIZATION=0

# ---------------------------------------------------------------------------
# Sólo si corrés el backend fuera de Podman (el compose ya las define)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://expenses_user:<password>@localhost:5432/expenses
# REDIS_URL=redis://localhost:6379/1
# REDIS_CACHE_URL=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Frontend (Vite). Se inyectan en build; no son secretos.
# ---------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_GOOGLE_CLIENT_ID=             # el mismo GOOGLE_CLIENT_ID del backend
VITE_TELEGRAM_OIDC_CLIENT_ID=
